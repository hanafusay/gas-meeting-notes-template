{
  "name": "gas-meeting-notes-template",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp appsscript.json dist/",
    "push": "pnpm build && clasp push",
    "pull": "clasp pull",
    "open": "clasp open"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@google/clasp": "3.2.0",
    "@types/google-apps-script": "1.0.83",
    "typescript": "5.7.2"
  }
}
